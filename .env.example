# Build-time feature flag. Enable only after the Apple OAuth environment
# variables documented in README.md are configured in Cloudflare Pages.
VITE_APPLE_SIGN_IN_ENABLED=false

# Runtime secrets belong in .dev.vars locally and Cloudflare Pages in
# production. These names are documented here without values.
# SESSION_SECRET=
# AUDIO_ORIGIN_URL=
# AUDIO_ORIGIN_TOKEN=
# BOT_API_TOKEN=
